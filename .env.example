# --- BizOS API --------------------------------------------------------------
BIZOS_API_URL=
BIZOS_PRODUCTS_PATH=/products
# Where orders are POSTed (JSON). Without it, orders cannot be saved.
BIZOS_ORDERS_PATH=
# Server-only. Never expose as NEXT_PUBLIC_*.
BIZOS_API_KEY=
# Use bundled dev-products.json when the API is unset/unreachable.
BIZOS_DEV_FALLBACK=true
# LOCAL DEMOS ONLY: accept orders that are not sent anywhere. Keep false in production.
BIZOS_ALLOW_SIMULATED_ORDERS=true

# Optional promo codes (JSON). Validated on the server when the order is placed.
# BIZOS_PROMO_CODES=[{"code":"WELCOME10","type":"percent","value":10,"minSubtotal":100,"maxDiscount":50,"expires":"2026-12-31"}]
BIZOS_PROMO_CODES=

# --- Admin dashboard (/admin) -----------------------------------------------
# Leave empty to disable /admin completely. Use 12+ characters.
ADMIN_PASSWORD=
# Optional extra secret used to sign admin sessions.
ADMIN_SESSION_SECRET=
# Optional GET endpoint listing orders, shown in /admin/orders.
BIZOS_ORDERS_LIST_PATH=

# --- Store ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
# 0 disables the free-delivery offer
NEXT_PUBLIC_FREE_SHIPPING_OVER=0
NEXT_PUBLIC_SHIPPING_FLAT=0
NEXT_PUBLIC_FEATURED_SLUG=
# Shown on /contact and footer only when set
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_SUPPORT_HOURS=

# --- Analytics / monitoring (all optional) ----------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_APP_ENV=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_ENV=development
SENTRY_AUTH_TOKEN=
